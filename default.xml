<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote alias="upstream" fetch="https://github.com/ubccr" name="ubccr"></remote>
  <remote alias="rvtovar" fetch="https://github.com/rvtovar" name="rvtovar"></remote>
  <remote name="github-ryanrath" alias="ryanrath" fetch="https://github.com/ryanrath"/>
  <default remote="ubccr" revision="main"></default>
  <!--
    Open XDMoD

    This is the main Open XDMoD repository. It will be installed by default.
    -->
  <project groups="xdmod" name="xdmod"></project>
  <!--
    Open XDMoD Modules

    These are Open XDMoD modules developed by the Open XDMoD team.
    They will be installed by default.
    -->
  <project groups="appkernels" name="xdmod-appkernels">
    <linkfile dest="xdmod/open_xdmod/modules/appkernels" src="."></linkfile>
  </project>
  <project groups="supremm" name="xdmod-supremm">
    <linkfile dest="xdmod/open_xdmod/modules/supremm" src="."></linkfile>
  </project>
  <project groups="ondemand" name="xdmod-ondemand">
    <linkfile dest="xdmod/open_xdmod/modules/ondemand" src="."></linkfile>
  </project>
  <project groups="introspection" name="xdmod-introspection">
    <linkfile dest="xdmod/open_xdmod/modules/introspection" src="."></linkfile>
  </project>
  <project groups="cloudbank" name="xdmod-cloudbank" remote="github-ryanrath" revision="add-allocation-type">
    <linkfile dest="xdmod/open_xdmod/modules/cloudbank" src="."></linkfile>
  </project>
  <project groups="nairr" name="xdmod-nairr" remote="rvtovar" revision="configupdates">
    <linkfile dest="xdmod/open_xdmod/modules/nairr" src="."></linkfile>
  </project>
  <!--
    Related Tools

    These projects are tools used by Open XDMoD but are not part of it.
    They are included for convenience, but they are not installed by default.
    -->
  <project groups="notdefault,supremm,tools" name="supremm" revision="master"></project>
  <project groups="notdefault,appkernels,tools" name="akrr" revision="master"></project>
</manifest>
